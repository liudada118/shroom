{
  "name": "sleep-monitor",
  "version": "1.0.0",
  "description": "睡眠监护仪 - 基于串口通信协议V1.3的睡眠检测软件",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"cd client && npm run dev\" \"nodemon server/serialServer.js\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "nodemon server/serialServer.js",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client && electron-builder -w",
    "build:mac": "npm run build:client && electron-builder -m"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "serialport": "^13.0.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.0"
  },
  "build": {
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/@serialport/**",
      "node_modules/node-gyp-build/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "client/dist",
        "to": "build"
      }
    ],
    "win": {
      "icon": "./assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@serialport/bindings-cpp",
      "electron"
    ]
  }
}
